{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"wranglerdev":"wrangler dev -c ./wrangler.jsonc -c ../do-worker/wrangler.jsonc",
		"prepare": "svelte-kit sync || echo ''",
