		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"svelte": "^5.41.1",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.15",
		"typescript": "^5.9.3",
		"vite": "^7.1.11",
		"wrangler": "^4.44.0"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^4.20251014.0"
	}
